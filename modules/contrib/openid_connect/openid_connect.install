/**
 * Enable core's file module.
 */
function openid_connect_update_30001() {
  \Drupal::service('module_installer')->install(['file']);
}

/**
 * Clean-up role_mappings in openid_connect.settings.
 */
function openid_connect_update_30002() {
  $config = \Drupal::configFactory()->getEditable('openid_connect.settings');
  $role_mappings = $config->get('role_mappings') ?? [];
  $role_mappings = array_filter($role_mappings, function ($value) {
    return !($value === []);
  });
  $config->set('role_mappings', $role_mappings);
  $config->save(TRUE);
}

/**
 * Repair incorrect Generic and Okta plugin scopes.
 */
function openid_connect_update_30003() {
  $storage = \Drupal::entityTypeManager()->getStorage('openid_connect_client');

  $clients = [];
  $clients += $storage->loadByProperties(['plugin' => 'generic']);
  $clients += $storage->loadByProperties(['plugin' => 'okta']);

  foreach ($clients as $client) {
    $config = $client->getPlugin()->getConfiguration();
    if ($config['scopes'] === '') {
      $client->getPlugin()->setConfiguration(['scopes' => []]);
      $client->save();
    }
  }
}

/**
 * Update plugins with "iss_allowed_domains" if it is missing.
 */
function openid_connect_update_30004() {
  $definitions = \Drupal::service('plugin.manager.openid_connect_client')->getDefinitions();

  foreach ($definitions as $plugin) {
    /** @var \Drupal\openid_connect\OpenIDConnectClientEntityInterface[] $clients */
    $clients = \Drupal::entityTypeManager()
      ->getStorage('openid_connect_client')
      ->loadByProperties(['plugin' => $plugin['id']]);

    foreach ($clients as $client) {
      $config = $client->getPlugin()->getConfiguration();
      if (empty($config['iss_allowed_domains'])) {
        $client->getPlugin()->setConfiguration(['iss_allowed_domains' => '']);
        $client->save();
      }
    }
  }
}

/**
 * Update all plugins to use the 'login' prompt.
 */
function openid_connect_update_30005() {
  // Superseded by openid_connect_update_30006.
}

/**
 * Update all plugins to use the 'login' prompt.
 */
function openid_connect_update_30006() {
  $configFactory = \Drupal::configFactory();
  $updatedConfigNames = [];
  foreach ($configFactory->listAll('openid_connect.client.') as $configName) {
    $config = $configFactory->getEditable($configName);
    $settings = $config->get('settings');
    $prompt = $settings['prompt'] ?? NULL;

    // Default the new value to the correct OIDC default.
    $newOidcPromptValue = ['login'];

    // If the old openid_connect_update_30005 ran successfully, this will be a
    // non-empty associative array. It could have also been updated since
    // that run, so, migrate that value across to the proper sequence.
    // Otherwise, if it doesn't exist, its probably because 30005 didn't run, or
    // the plugin doesn't have a 'prompt' key.
    // This could also be a string, in the case of windows_aad, in which case,
    // we should convert it to an array.
    if (is_string($prompt)) {
      // This was likely provided by another plugin (openid_connect_windows_aad)
      // Let's convert their string value to an array to match our upstream
      // schema.
      // Explode the value based on space, as that _should_ be the value if this
      // setting was following OpenId Spec.
      $newOidcPromptValue = explode(' ', trim($prompt));
    }
    elseif (is_array($prompt)) {
      // If the array is not empty and is associative, then 30005 likely ran or
      // the value was updated by an admin. We need to convert this to
      // a sequence instead of an associative array.
      if (
        !empty($prompt) &&
        array_keys($prompt) !== range(0, count($prompt) - 1)
      ) {
        $newOidcPromptValue = array_values($prompt);
      }
      else {
        $newOidcPromptValue = $prompt;
      }
    }
    elseif (
      is_null($prompt) &&
      $config->get('plugin') === 'windows_aad'
    ) {
      // If the prompt is null and the plugin is windows_aad, default to
      // the original default of the openid_connect_windows_aad, which was
      // <noprompt>. This becomes an empty array in this structure.
      $newOidcPromptValue = [];
    }

    $config->set('settings.prompt', $newOidcPromptValue)
      ->save(TRUE);
    $updatedConfigNames[] = $configName;
  }

  return new TranslatableMarkup('OpenID Connect client plugins updated: @plugins', ['@plugins' => implode(', ', $updatedConfigNames)]);
}

/**
 * Update plugins with 'provider_slug'.
 */
function openid_connect_update_30007() {
  $configFactory = \Drupal::configFactory();
  $updatedConfigNames = [];

  foreach ($configFactory->listAll('openid_connect.client.') as $configName) {
    $config = $configFactory->getEditable($configName);
    $settings = $config->get('settings');

    if (!array_key_exists('provider_slug', (array) $settings)) {
      $config->set('settings.provider_slug', '')->save(TRUE);
      $updatedConfigNames[] = $configName;
    }
  }

  return new TranslatableMarkup('OpenID Connect client plugins updated: @plugins', ['@plugins' => implode(', ', $updatedConfigNames)]);
}
