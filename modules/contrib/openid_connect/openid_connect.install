<?php

/**
 * @file
 * Install, update and uninstall functions for the OpenID Connect module.
 */

/* @noinspection PhpUnnecessaryFullyQualifiedNameInspection */
/* @noinspection PhpUnused */

use Drupal\Core\Config\Entity\ConfigEntityType;
use Drupal\Core\Database\IntegrityConstraintViolationException;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\Core\Utility\UpdateException;

/**
 * Implements hook_requirements().
 */
function openid_connect_requirements($phase) {
  $requirements = [];
  if ($phase == 'runtime') {
    if (\Drupal::config('openid_connect.settings')->get('connect_existing_users')) {
      $requirements['openid_connect_connect_existing_users'] = [
        'title' => t('OpenID Connect'),
        'value' => t('Automatically connect existing users enabled'),
        'description' => t('The "Automatically connect existing users" option is enabled. This can lead to security vulnerabilities. It is <strong>highly recommended</strong> to <a href=":url">disable this option</a>.',
          [':url' => Url::fromRoute('openid_connect.admin_settings', [], ['fragment' => 'edit-connect-existing-users'])->toString()]
        ),
        'severity' => REQUIREMENT_WARNING,
      ];
    }

    // Check if any enabled client has 'prompt' set to 'none'.
    $entity_storage = \Drupal::entityTypeManager()->getStorage('openid_connect_client');
    /** @var \Drupal\openid_connect\OpenIDConnectClientEntityInterface[] $clients */
    $clients = $entity_storage->loadByProperties(['status' => TRUE]);

    foreach ($clients as $client) {
      $settings = $client->getPlugin()->getConfiguration();

      $prompts = !empty($settings['prompt']) && is_array($settings['prompt']) ? array_filter($settings['prompt']) : [];
      // Check if 'prompt' is set to 'none'.
      if (
        empty($prompts) ||
        (in_array('none', $prompts) && count($prompts) === 1)
      ) {
        $requirements['openid_connect_prompt_none'] = [
          'title' => t('OpenID Connect'),
          'value' => t('Client "prompt" may be misconfigured'),
          'description' => t('At least one OpenID Connect client is configured with the "prompt" parameter set to "none" or without a "prompt". This can lead to security vulnerabilities. It is <strong>highly recommended</strong> to change this setting unless you are aware of the risks.'),
          'severity' => REQUIREMENT_WARNING,
        ];

        // No need to check other clients once we've found one with prompt=none.
        break;
      }
    }

    // Update 8205 only drops the old 'openid_connect_authmap' table once
    // update 8204 has moved every record into 'authmap'. So if the table is
    // still there, the migration did not complete. Sites that have not yet run
    // update 8205 are skipped: core already reports their pending updates.
    $installed_version = \Drupal::service('update.update_hook_registry')
      ->getInstalledVersion('openid_connect');
    $database = \Drupal::database();

    if ($installed_version >= 8205 && $database->schema()->tableExists('openid_connect_authmap')) {
      $remaining = (int) $database->select('openid_connect_authmap')
        ->countQuery()
        ->execute()
        ->fetchField();

      // Records left behind are a real problem: another account is already
      // mapped to the same identifier, so these accounts cannot authenticate.
      // An empty table is only left-over clean-up.
      $requirements['openid_connect_authmap_migration'] = $remaining ? [
        'title' => t('OpenID Connect authmap migration'),
        'value' => t('Not completed'),
        'description' => t('@number record(s) could not be moved from the old <code>openid_connect_authmap</code> table into the <code>authmap</code> table, usually because another account is already mapped to the same identifier for that client. Any account whose record was not migrated <strong>cannot authenticate</strong> through OpenID Connect until this is resolved. Review the OpenID Connect log messages to identify them, migrate or remove the conflicting records, then drop the <code>openid_connect_authmap</code> table.',
          ['@number' => $remaining]
        ),
        'severity' => REQUIREMENT_WARNING,
      ] : [
        'title' => t('OpenID Connect authmap migration'),
        'value' => t('Clean-up pending'),
        'description' => t('The old <code>openid_connect_authmap</code> table is empty but still present. Its records have all been migrated or removed, so the table can now be dropped.'),
        'severity' => REQUIREMENT_INFO,
      ];
    }
  }
  return $requirements;
}

/**
 * Add default config for Facebook and LinkedIn provider.
 */
function openid_connect_update_8101() {
  $config_factory = \Drupal::configFactory();

  $config = $config_factory->getEditable('openid_connect.settings.facebook');
  $config->set('enabled', FALSE);
  $config->set('settings', [
    'client_id' => '',
    'client_secret' => '',
    'api_version' => '',
  ]);
  $config->save(TRUE);

  $config = $config_factory->getEditable('openid_connect.settings.linkedin');
  $config->set('enabled', FALSE);
  $config->set('settings', [
    'client_id' => '',
    'client_secret' => '',
  ]);
  $config->save(TRUE);
}

