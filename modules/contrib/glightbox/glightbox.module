<?php

/**
 * @file
 * A light-weight, customizable lightbox plugin.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\glightbox\Hook\GlightboxHooks;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Render\Markup;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function glightbox_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(GlightboxHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function glightbox_theme() {
  return \Drupal::service(GlightboxHooks::class)->theme();
}

/**
 * Implements hook_library_info_alter().
 */
#[LegacyHook]
function glightbox_library_info_alter(&$libraries, $module) {
  \Drupal::service(GlightboxHooks::class)->libraryInfoAlter($libraries, $module);
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function glightbox_token_info()
{
    return \Drupal::service(GlightboxHooks::class)->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function glightbox_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata)
{
    return \Drupal::service(GlightboxHooks::class)->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}
