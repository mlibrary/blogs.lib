<?php

/**
 * @file
 * This module allows site builders and developers to manage oEmbed providers.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\oembed_providers\Hook\FormHooks;
use Drupal\oembed_providers\Hook\MediaSourceHooks;

/**
 * Implements hook_media_source_info_alter().
 *
 * @phpstan-ignore-next-line
 */
#[LegacyHook]
function oembed_providers_media_source_info_alter(array &$sources) {
  \Drupal::service(MediaSourceHooks::class)->mediaSourceInfoAlter($sources);
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * @phpstan-ignore-next-line
 */
#[LegacyHook]
function oembed_providers_form_media_type_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(FormHooks::class)->mediaTypeEditFormAlter($form, $form_state, $form_id);
}
